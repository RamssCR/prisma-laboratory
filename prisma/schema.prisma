generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  active    Boolean   @default(true)
  sessions  Session[]
}

model Vehicle {
  id              Int                  @id @default(autoincrement())
  brandId         Int
  model           String
  year            Int
  displacement    Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  active          Boolean              @default(true)
  compatibilities ProductCompability[]
  brand           Brand                @relation(fields: [brandId], references: [id])

  @@unique([brandId, model, year])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  active    Boolean   @default(true)
  slug      String    @unique
  products  Product[]
  vehicles  Vehicle[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  active    Boolean   @default(true)
  slug      String    @unique
  products  Product[]
}

model Product {
  id            Int                  @id @default(autoincrement())
  sku           String               @unique
  name          String
  price         Float
  minStock      Int                  @default(5)
  categoryId    Int
  brandId       Int
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt
  active        Boolean              @default(true)
  slug          String               @unique
  movements     InventoryMovement[]
  brand         Brand                @relation(fields: [brandId], references: [id])
  category      Category             @relation(fields: [categoryId], references: [id])
  compatibility ProductCompability[]
}

model InventoryMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  quantity  Int
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  active    Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id])
}

model ProductCompability {
  id        Int      @id @default(autoincrement())
  productId Int
  vehicleId Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  active    Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Session {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  revoked   Boolean   @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}
